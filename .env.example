# Local development only. pnpm run setup replaces both CHANGE_ME values in .env.
APP_ORIGIN=http://localhost:4400
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
POSTGRES_DB=lattice
POSTGRES_USER=lattice
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://lattice:CHANGE_ME@127.0.0.1:5440/lattice
REDIS_URL=redis://127.0.0.1:6380/0
STORAGE_ROOT=.data/storage
MODEL_CACHE_ROOT=.data/models
RAG_MODE=RETRIEVAL_ONLY
LOCAL_EMBED_MODEL_REVISION=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DIGEST=
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=
MAX_WORKSPACE_STORAGE_BYTES=2147483648
MAX_DAILY_ANSWER_TOKENS=100000
SMTP_HOST=localhost
SMTP_PORT=1026
DEMO_MODE=false
